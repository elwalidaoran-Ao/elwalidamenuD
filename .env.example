# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ====================================================================
# SUPABASE CONFIGURATION (Framework: Vite + React SPA)
# ====================================================================
# IMPORTANT: In Vite, all environment variables exposed to the client
# browser MUST be prefixed with VITE_.
#
# Configure these variables in Vercel:
# Project Settings > Environment Variables > Add New
# ====================================================================

# Supabase Project URL
VITE_SUPABASE_URL="https://kyybplhoanqumlvxqmys.supabase.co"

# Supabase Anonymous Publishable Key (safe for public client usage with RLS)
# Found in: Supabase Dashboard > Project Settings > API > Project API Keys > anon / public
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
